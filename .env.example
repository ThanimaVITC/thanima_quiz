# Copy this file to .env and fill in your own MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Required to use the admin panel at /admin - pick a strong password.
# Without this set, /admin returns 503 (disabled) rather than falling back to no auth.
ADMIN_PASSWORD=

# Optional overrides
MONGODB_DB=quiz
PORT=3000
